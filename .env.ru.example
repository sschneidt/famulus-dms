# Famulus DMS - пример конфигурации (Docker)
# Скопируйте этот файл в ".env" и измените отмеченные значения. Это единственный ручной шаг перед
# "docker compose up" - всё остальное (пользователи, домохозяйство, категории) настраивается потом
# в веб-мастере первоначальной настройки.
# Другие языки (те же значения, различаются только комментарии): .env.example (английский), .env.de.example (немецкий)

# --- Общее ---
TZ=Europe/Berlin                          # ваш часовой пояс, например Europe/Moscow или America/New_York

# --- База данных ---
POSTGRES_USER=homedms
POSTGRES_PASSWORD=CHANGE_ME               # <- обязательно измените
POSTGRES_DB=homedms

# --- Поиск ---
MEILI_MASTER_KEY=CHANGE_ME_TOO            # <- обязательно измените (не менее 16 символов)

# --- Безопасность ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING   # <- обязательно измените, например `openssl rand -hex 32`

# --- Места хранения на NAS ---
# Где хранятся сами документы (папка должна существовать на Synology,
# например общая папка /volume1/homedms/documents).
DOCUMENTS_PATH=./data/documents
# Отслеживаемая папка сканирования (многофункциональное устройство кладёт сюда файлы по SMB/FTP). Famulus DMS
# забирает новые PDF/изображения раз в минуту, а оригиналы затем переносит в _imported/ (или _failed/).
SCAN_FOLDER_PATH=./data/scan

# --- ИИ ---
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_CAUTION_LEVEL=normal                   # vorsichtig (осторожно) | normal (обычно) | mutig (смело)
OCR_LANGUAGES=deu+eng                     # языки распознавания текста по умолчанию; языки интерфейса добавляются сами, другие пакеты - на странице "Языки"

# --- Сеть и шифрование (docs/Sicherheitskonzept.md) ---
# Famulus DMS доступен по HTTPS: https://<nas>:8443. Новые устройства один раз доверяют сертификату через
# http://<nas>:8000/zertifikat (инструкция для iPhone, Android, Windows, Mac).
TLS_MODE=auto                             # auto | off (только за обратным прокси с HTTPS) | custom
TLS_HOSTNAMES=nas,nas.local,192.168.1.10  # <- укажите имя(имена) и IP-адрес NAS в домашней сети
APP_HTTP_PORT=8000                        # перенаправление + справка по сертификату
APP_HTTPS_PORT=8443                       # сам Famulus DMS
APP_BIND=0.0.0.0                          # 127.0.0.1, если перед ним стоит обратный прокси на том же NAS
SETUP_CODE=                               # пусто = случайный код настройки в журнале

# --- Версия образа ---
# Готовый образ берётся из GitHub Container Registry. С APP_VERSION=1.2 вы остаётесь на исправлениях
# версии 1.2.x, с "latest" получаете каждую новую версию (см. docs/Updates.md).
# Собрать самостоятельно (разработка): APP_IMAGE=homedms/backend
APP_IMAGE=ghcr.io/sschneidt/famulus-dms
APP_VERSION=latest
