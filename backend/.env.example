# Local development. For the full stack see docker-compose.yml in the repository root.
APP_ROLE=api
DATABASE_URL=postgresql+asyncpg://homedms:changeme@127.0.0.1:5432/homedms
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_KEY=changeme
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_CAUTION_LEVEL=normal
# For local development outside Docker a relative path is enough. In the container it is always
# /data/documents (see docker-compose.yml - a fixed mount point, not configurable through DOCUMENTS_PATH in
# the app environment, but through the host path in the .env of docker-compose).
DOCUMENTS_PATH=./data/documents
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
TZ=Europe/Berlin
