# Lokale Entwicklung. Fuer den vollen Stack siehe docker-compose.yml im Repo-Root.
APP_ROLE=api
DATABASE_URL=postgresql+asyncpg://homedms:changeme@127.0.0.1:5432/homedms
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=changeme
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_CAUTION_LEVEL=normal
# Fuer lokale Entwicklung ausserhalb von Docker: relativer Pfad reicht. Im Container immer
# /data/documents (siehe docker-compose.yml - fester Mount-Punkt, dort nicht ueber DOCUMENTS_PATH
# im App-Env konfigurierbar, sondern ueber den Host-Pfad im docker-compose .env).
DOCUMENTS_PATH=./data/documents
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
TZ=Europe/Berlin
