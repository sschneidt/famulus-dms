# Famulus DMS – Beispiel-Konfiguration
# Kopieren nach ".env" und die markierten Werte anpassen. Das reicht laut
# Anforderungsdokument 4.7 als einziger manueller Schritt vor "docker compose up" –
# alle Inhalte (Nutzer, Haushalt, Kategorien) kommen danach über den
# Web-Einrichtungsassistenten.

# --- Allgemein ---
TZ=Europe/Berlin

# --- Datenbank ---
POSTGRES_USER=homedms
POSTGRES_PASSWORD=CHANGE_ME               # <- unbedingt ändern
POSTGRES_DB=homedms

# --- Suche ---
MEILI_MASTER_KEY=CHANGE_ME_TOO            # <- unbedingt ändern (min. 16 Zeichen)

# --- Sicherheit ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING   # <- unbedingt ändern, z. B. `openssl rand -hex 32`

# --- Speicherorte auf dem NAS ---
# Wo die eigentlichen Dokumente abgelegt werden (muss auf Synology existieren,
# z. B. ein freigegebener Ordner /volume1/homedms/documents).
DOCUMENTS_PATH=./data/documents
# Der überwachte Scan-Ordner (Multifunktionsgerät legt hier per SMB/FTP ab). Famulus DMS holt jede
# Minute neue PDF/Bilder ab und verschiebt die Originale danach nach _imported/ (bzw. _failed/).
SCAN_FOLDER_PATH=./data/scan

# --- KI ---
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_CAUTION_LEVEL=normal                   # vorsichtig | normal | mutig
OCR_LANGUAGES=deu+eng                     # Standard der Texterkennung; Oberflaechensprachen kommen dazu, weitere Pakete auf der Seite "Sprachen"

# --- Netzwerk & Verschlüsselung (docs/Sicherheitskonzept.md) ---
# Famulus DMS ist per HTTPS erreichbar: https://<nas>:8443. Neue Geräte vertrauen dem Zertifikat einmalig
# über http://<nas>:8000/zertifikat (Anleitung für iPhone, Android, Windows, Mac).
TLS_MODE=auto                             # auto | off (nur hinter Reverse Proxy mit HTTPS) | custom
TLS_HOSTNAMES=nas,nas.local,192.168.1.10  # <- Name(n) und IP-Adresse des NAS im Heimnetz eintragen
APP_HTTP_PORT=8000                        # Umleitung + Zertifikat-Hilfe
APP_HTTPS_PORT=8443                       # Famulus DMS selbst
APP_BIND=0.0.0.0                          # 127.0.0.1, wenn ein Reverse Proxy auf demselben NAS vorschaltet
SETUP_CODE=                               # leer = zufälliger Einrichtungscode im Protokoll

# --- Image-Version ---
# Das fertige Image kommt aus der GitHub Container Registry. Mit APP_VERSION=1.2 bleibst du bei den
# Fehlerkorrekturen von 1.2.x, mit "latest" bekommst du jede neue Version (siehe docs/Updates.md).
# Selbst bauen (Entwicklung): APP_IMAGE=homedms/backend
APP_IMAGE=ghcr.io/sschneidt/famulus-dms
APP_VERSION=latest
