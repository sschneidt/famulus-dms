# Famulus DMS - example configuration (Docker)
# Copy this file to ".env" and change the marked values. That is the only manual step before
# "docker compose up" - everything else (users, household, categories) is set up afterwards in the
# web setup wizard.
# Other languages (same values, only the comments differ): .env.de.example (Deutsch), .env.ru.example (Russian)

# --- General ---
TZ=Europe/Berlin                          # your time zone, e.g. Europe/Moscow or America/New_York

# --- Database ---
POSTGRES_USER=homedms
POSTGRES_PASSWORD=CHANGE_ME               # <- change this
POSTGRES_DB=homedms

# --- Search ---
MEILI_MASTER_KEY=CHANGE_ME_TOO            # <- change this (at least 16 characters)

# --- Security ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING   # <- change this, e.g. `openssl rand -hex 32`

# --- Storage locations on the NAS ---
# Where the documents are stored (the folder must exist on a Synology,
# e.g. a shared folder /volume1/homedms/documents).
DOCUMENTS_PATH=./data/documents
# The watched scan folder (the multifunction printer drops files here via SMB/FTP). Famulus DMS picks up new
# PDFs/images every minute and then moves the originals to _imported/ (or _failed/).
SCAN_FOLDER_PATH=./data/scan

# --- AI ---
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_CAUTION_LEVEL=normal                   # vorsichtig (careful) | normal | mutig (bold)
OCR_LANGUAGES=deu+eng                     # default text recognition languages; the interface languages are added automatically, more packs on the "Languages" page

# --- Network & encryption (docs/Sicherheitskonzept.md) ---
# Famulus DMS is reachable over HTTPS: https://<nas>:8443. New devices trust the certificate once via
# http://<nas>:8000/zertifikat (instructions for iPhone, Android, Windows, Mac).
TLS_MODE=auto                             # auto | off (only behind a reverse proxy with HTTPS) | custom
TLS_HOSTNAMES=nas,nas.local,192.168.1.10  # <- enter the name(s) and IP address of the NAS in your home network
APP_HTTP_PORT=8000                        # redirect + certificate help
APP_HTTPS_PORT=8443                       # Famulus DMS itself
APP_BIND=0.0.0.0                          # 127.0.0.1 if a reverse proxy on the same NAS sits in front
SETUP_CODE=                               # empty = random setup code in the log

# --- Image version ---
# The ready-made image comes from the GitHub Container Registry. With APP_VERSION=1.2 you stay with the
# fixes of 1.2.x, with "latest" you get every new version (see docs/Updates.md).
# Build it yourself (development): APP_IMAGE=homedms/backend
APP_IMAGE=ghcr.io/sschneidt/famulus-dms
APP_VERSION=latest
