# Famulus DMS OHNE Docker (Windows-PC oder Linux-Server) - Einstellungen.
# Die Installationsskripte (scripts/install-linux.sh, scripts/install-windows.ps1) legen daraus automatisch
# "homedms.env" an und füllen Passwörter und Schlüssel zufällig. Von Hand: Datei als "homedms.env" in den
# Famulus-DMS-Ordner kopieren und die Werte anpassen.
# Für den Docker-Betrieb gilt stattdessen .env (Vorlage .env.example).
# Andere Sprachen (gleiche Werte, nur die Kommentare unterscheiden sich): homedms.env.example (English), homedms.env.ru.example (Russisch)
#
# Windows: Pfade mit normalen Schrägstrichen schreiben, z. B. C:/Famulus-Data/documents

# --- Datenbank (PostgreSQL 14 oder neuer, Erweiterung pg_trgm - ist bei PostgreSQL dabei) ---
DATABASE_URL=postgresql://homedms:CHANGE_ME@127.0.0.1:5432/homedms

# --- Anmeldung: langer Zufallswert, nie weitergeben ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# --- Ordner ---
# Hier legt Famulus DMS die Dokumente ab (Haushalt/Kategorie/Jahr) - gehört ins Backup.
DOCUMENTS_PATH=/var/lib/homedms/documents
# Scan-Ordner: was hier landet, wird jede Minute importiert.
SCAN_PATH=/var/lib/homedms/scan
# Protokolldateien (leer = nur Konsole)
LOG_DIR=/var/lib/homedms/logs
# Gebaute Weboberfläche (relativ zu backend/)
FRONTEND_DIST=../frontend/dist

# --- Webserver & Verschlüsselung (docs/Sicherheitskonzept.md) ---
HOST=0.0.0.0
# Famulus DMS selbst läuft per HTTPS auf HTTPS_PORT; PORT (HTTP) leitet nur um und zeigt unter
# /zertifikat, wie ein neues Gerät der Famulus-DMS-Zertifizierungsstelle vertraut.
PORT=8000
HTTPS_PORT=8443
# auto = eigene Zertifizierungsstelle | off = nur hinter einem Reverse Proxy mit HTTPS | custom
TLS_MODE=auto
# Ordner für Zertifizierungsstelle + Schlüssel (nicht im Dokumente-Ordner!)
TLS_DIR=/var/lib/homedms/tls
# Weitere Namen/IP-Adressen, unter denen Famulus DMS erreichbar ist (Rechnername und IPs erkennt es selbst)
TLS_HOSTNAMES=
# Einmal-Code für die Ersteinrichtung (leer = zufällig, steht dann im Protokoll)
SETUP_CODE=

# --- KI (Ollama, https://ollama.com) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=900

# --- Texterkennung (Tesseract) ---
OCR_LANGUAGES=deu+eng
# Eigener Ordner für Sprachpakete (mitgelieferte + auf der Seite "Sprachen" nachinstallierte)
TESSDATA_DIR=/var/lib/homedms/tessdata
# Pfad zu tesseract(.exe), nur nötig, wenn es nicht automatisch gefunden wird
TESSERACT_CMD=

# --- Suche (Meilisearch, optional) ---
# Leer lassen = Suche nur über die Datenbank (Teilwörter, ohne Tippfehler-Toleranz).
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_KEY=CHANGE_ME_LONG_RANDOM_STRING
# Pfad zur meilisearch(.exe) - dann startet Famulus DMS die Suche selbst mit
MEILISEARCH_BINARY=
MEILISEARCH_DATA=/var/lib/homedms/meilisearch

TZ=Europe/Berlin
