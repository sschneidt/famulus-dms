# HomeDMS OHNE Docker (Windows-PC oder Linux-Server) - Einstellungen.
# Die Installationsskripte (scripts/install-linux.sh, scripts/install-windows.ps1) legen daraus
# automatisch "homedms.env" an und fuellen Passwoerter/Schluessel zufaellig. Von Hand: Datei als
# "homedms.env" in diesen Ordner kopieren und die Werte anpassen.
# Fuer den Docker-Betrieb gilt stattdessen .env (Vorlage .env.example).
#
# Windows: Pfade mit normalen Schraegstrichen schreiben, z. B. C:/HomeDMS/data/documents

# --- Datenbank (PostgreSQL 14 oder neuer, Erweiterung pg_trgm - ist bei PostgreSQL dabei) ---
DATABASE_URL=postgresql://homedms:PASSWORT@localhost:5432/homedms

# --- Anmeldung: langer Zufallswert, nie weitergeben ---
JWT_SECRET=bitte-durch-einen-langen-zufallswert-ersetzen

# --- Ordner ---
# Hier legt HomeDMS die Dokumente ab (Haushalt/Kategorie/Jahr) - gehoert ins Backup.
DOCUMENTS_PATH=/var/lib/homedms/documents
# Scan-Ordner: was hier landet, wird jede Minute importiert.
SCAN_PATH=/var/lib/homedms/scan
# Protokolldateien (leer = nur Konsole)
LOG_DIR=/var/lib/homedms/logs
# Gebaute Weboberflaeche (relativ zu backend/)
FRONTEND_DIST=../frontend/dist

# --- Webserver ---
HOST=0.0.0.0
PORT=8000

# --- KI (Ollama, https://ollama.com) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=900

# --- Texterkennung (Tesseract) ---
OCR_LANGUAGES=deu+eng
# Pfad zu tesseract(.exe), nur noetig, wenn es nicht automatisch gefunden wird
TESSERACT_CMD=

# --- Suche (Meilisearch, optional) ---
# Leer lassen = Suche nur ueber die Datenbank (Teilwoerter, ohne Tippfehler-Toleranz).
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_KEY=bitte-durch-einen-langen-zufallswert-ersetzen
# Pfad zur meilisearch(.exe) - dann startet HomeDMS die Suche selbst mit
MEILISEARCH_BINARY=
MEILISEARCH_DATA=/var/lib/homedms/meilisearch

TZ=Europe/Berlin
