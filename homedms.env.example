# Famulus DMS WITHOUT Docker (Windows PC or Linux server) - settings.
# The install scripts (scripts/install-linux.sh, scripts/install-windows.ps1) create "homedms.env" from this file
# automatically and fill in passwords and keys at random. By hand: copy this file to the Famulus DMS folder as
# "homedms.env" and adjust the values.
# For Docker, .env is used instead (template .env.example).
# Other languages (same values, only the comments differ): homedms.env.de.example (Deutsch), homedms.env.ru.example (Russian)
#
# Windows: write paths with forward slashes, e.g. C:/Famulus-Data/documents

# --- Database (PostgreSQL 14 or newer, extension pg_trgm - it comes with PostgreSQL) ---
DATABASE_URL=postgresql://homedms:CHANGE_ME@127.0.0.1:5432/homedms

# --- Sign-in: a long random value, never share it ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# --- Folders ---
# Famulus DMS stores the documents here (household/category/year) - include it in your backup.
DOCUMENTS_PATH=/var/lib/homedms/documents
# Scan folder: whatever lands here is imported every minute.
SCAN_PATH=/var/lib/homedms/scan
# Log files (empty = console only)
LOG_DIR=/var/lib/homedms/logs
# Built web interface (relative to backend/)
FRONTEND_DIST=../frontend/dist

# --- Web server & encryption (docs/Sicherheitskonzept.md) ---
HOST=0.0.0.0
# Famulus DMS itself runs over HTTPS on HTTPS_PORT; PORT (HTTP) only redirects and shows on
# /zertifikat how a new device trusts the Famulus DMS certificate authority.
PORT=8000
HTTPS_PORT=8443
# auto = own certificate authority | off = only behind a reverse proxy with HTTPS | custom
TLS_MODE=auto
# Folder for the certificate authority + keys (not inside the documents folder!)
TLS_DIR=/var/lib/homedms/tls
# More names/IP addresses under which Famulus DMS is reachable (it detects the computer name and IPs itself)
TLS_HOSTNAMES=
# One-time code for the first setup (empty = random, shown in the log)
SETUP_CODE=

# --- AI (Ollama, https://ollama.com) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=900

# --- Text recognition (Tesseract) ---
OCR_LANGUAGES=deu+eng
# Own folder for language packs (bundled ones + those installed later on the "Languages" page)
TESSDATA_DIR=/var/lib/homedms/tessdata
# Path to tesseract(.exe), only needed if it is not found automatically
TESSERACT_CMD=

# --- Search (Meilisearch, optional) ---
# Leave empty = search only through the database (partial words, no typo tolerance).
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_KEY=CHANGE_ME_LONG_RANDOM_STRING
# Path to meilisearch(.exe) - then Famulus DMS starts the search itself
MEILISEARCH_BINARY=
MEILISEARCH_DATA=/var/lib/homedms/meilisearch

TZ=Europe/Berlin
