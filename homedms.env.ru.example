# Famulus DMS БЕЗ Docker (компьютер с Windows или сервер Linux) - настройки.
# Скрипты установки (scripts/install-linux.sh, scripts/install-windows.ps1) сами создают из этого файла
# "homedms.env" и заполняют пароли и ключи случайными значениями. Вручную: скопируйте файл в папку
# Famulus DMS под именем "homedms.env" и измените значения.
# Для работы в Docker используется .env (шаблон .env.example).
# Другие языки (те же значения, различаются только комментарии): homedms.env.example (английский), homedms.env.de.example (немецкий)
#
# Windows: пути пишите с прямыми косыми чертами, например C:/Famulus-Data/documents

# --- База данных (PostgreSQL 14 или новее, расширение pg_trgm - входит в состав PostgreSQL) ---
DATABASE_URL=postgresql://homedms:CHANGE_ME@127.0.0.1:5432/homedms

# --- Вход: длинное случайное значение, никому не передавайте ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# --- Папки ---
# Здесь Famulus DMS хранит документы (домохозяйство/категория/год) - включите её в резервное копирование.
DOCUMENTS_PATH=/var/lib/homedms/documents
# Папка сканирования: всё, что сюда попадает, импортируется раз в минуту.
SCAN_PATH=/var/lib/homedms/scan
# Файлы журнала (пусто = только консоль)
LOG_DIR=/var/lib/homedms/logs
# Собранный веб-интерфейс (относительно backend/)
FRONTEND_DIST=../frontend/dist

# --- Веб-сервер и шифрование (docs/Sicherheitskonzept.md) ---
HOST=0.0.0.0
# Сам Famulus DMS работает по HTTPS на HTTPS_PORT; PORT (HTTP) только перенаправляет и на странице
# /zertifikat показывает, как новое устройство доверяет центру сертификации Famulus DMS.
PORT=8000
HTTPS_PORT=8443
# auto = собственный центр сертификации | off = только за обратным прокси с HTTPS | custom
TLS_MODE=auto
# Папка для центра сертификации + ключей (не внутри папки документов!)
TLS_DIR=/var/lib/homedms/tls
# Другие имена/IP-адреса, по которым доступен Famulus DMS (имя компьютера и IP он определяет сам)
TLS_HOSTNAMES=
# Одноразовый код для первой настройки (пусто = случайный, он будет в журнале)
SETUP_CODE=

# --- ИИ (Ollama, https://ollama.com) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=900

# --- Распознавание текста (Tesseract) ---
OCR_LANGUAGES=deu+eng
# Собственная папка для языковых пакетов (встроенные + установленные позже на странице "Языки")
TESSDATA_DIR=/var/lib/homedms/tessdata
# Путь к tesseract(.exe), нужен только если он не находится автоматически
TESSERACT_CMD=

# --- Поиск (Meilisearch, необязательно) ---
# Оставьте пустым = поиск только через базу данных (части слов, без допуска опечаток).
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_KEY=CHANGE_ME_LONG_RANDOM_STRING
# Путь к meilisearch(.exe) - тогда Famulus DMS сам запускает поиск
MEILISEARCH_BINARY=
MEILISEARCH_DATA=/var/lib/homedms/meilisearch

TZ=Europe/Berlin
